---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
import type { AppPageProps } from '@/apps/types';
import './theme.css';

interface Props extends AppPageProps {}

const { app } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={app.name} app={app} description={app.tagline}>
  <div class="app-landing">
    <main class="app-landing__main">
      <h1 class="app-landing__name">{app.name}</h1>
      <p class="app-landing__tagline">{app.tagline}</p>
      <nav class="app-landing__links">
        <a href={`${base}${app.slug}/support/`}>サポート</a>
        <a href={`${base}${app.slug}/privacy/`}>プライバシーポリシー</a>
        <a href={`${base}${app.slug}/terms/`}>利用規約</a>
      </nav>
    </main>

    <footer class="app-landing__footer">
      <p>&copy; {new Date().getFullYear()} {site.operatorName}</p>
    </footer>
  </div>
</BaseLayout>
