---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import { site } from '@/config/site';
import { defaultLocale } from '@/config/i18n';
import { localizePath, t } from '@/i18n';
import type { AppPageProps } from '@/apps/types';

interface Props extends AppPageProps {}

const { app, locale = defaultLocale } = Astro.props;
---

<BaseLayout title={app.name} app={app} locale={locale} description={app.tagline}>
  <div class="wt-page">
    <header class="wt-bar">
      <span>{app.name}</span>
      <span>STATUS / OK</span>
    </header>

    <main class="wt-main">
      <section class="wt-panel">
        <p class="wt-label">Application</p>
        <h1 class="wt-title">{app.name}</h1>
        <p class="wt-tagline">{app.tagline}</p>
        <nav class="wt-links">
          <a href={localizePath(`${app.slug}/support/`, locale)}>
            {t(locale, 'nav.support')} <span>support</span>
          </a>
          <a href={localizePath(`${app.slug}/privacy/`, locale)}>
            {t(locale, 'nav.privacy')} <span>privacy</span>
          </a>
          <a href={localizePath(`${app.slug}/terms/`, locale)}>
            {t(locale, 'nav.terms')} <span>terms</span>
          </a>
        </nav>
      </section>
    </main>

    <footer class="wt-foot">
      <LanguageSwitcher locale={locale} />
      <p>&copy; {new Date().getFullYear()} {site.operatorName}</p>
    </footer>
  </div>
</BaseLayout>
