---
import { localeLabels, getAlternateUrls, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale: currentLocale } = Astro.props;
const alternates = getAlternateUrls(Astro.url.pathname, currentLocale);
---

<nav class="language-switcher" aria-label={localeLabels[currentLocale]}>
  {
    alternates.map(({ locale, href }) => (
      <a
        href={href}
        hreflang={locale}
        lang={locale}
        aria-current={locale === currentLocale ? 'true' : undefined}
      >
        {localeLabels[locale]}
      </a>
    ))
  }
</nav>

<style>
  .language-switcher {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }

  .language-switcher a {
    color: var(--color-muted, #5c5c5c);
    text-decoration: none;
  }

  .language-switcher a[aria-current='true'] {
    color: var(--color-text, #1a1a1a);
    font-weight: 600;
  }
</style>
