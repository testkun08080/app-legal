---
import LegalLayout from '@/layouts/LegalLayout.astro';
import { getSupportEmail } from '@/apps';
import { getLegalDoc } from '@/lib/legal';
import { localizedApp, localizePath, t, type Locale } from '@/i18n';
import type { AppConfig } from '@/apps/types';
import { render } from 'astro:content';

interface Props {
  app: AppConfig;
  locale: Locale;
}

const { app: rawApp, locale } = Astro.props;
const app = localizedApp(rawApp, locale);
const supportEmail = getSupportEmail(rawApp);

/**
 * `src/content/legal/<slug>/<locale>/support.md` があれば、その内容を
 * 問い合わせ先の下に差し込みます。無い場合は連絡先と法務リンクだけの共通ページです。
 */
const doc = await getLegalDoc(rawApp.slug, 'support', locale);
const Content = doc ? (await render(doc)).Content : undefined;
---

<LegalLayout
  title={t(locale, 'support.title')}
  app={app}
  rawApp={rawApp}
  currentPath="support"
  updated={doc?.data.updated}
  locale={locale}
>
  <p>{app.tagline}</p>

  <p>{t(locale, 'support.contactIntro', app.name)}</p>

  <div class="contact-block">
    <p>
      <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
    </p>
  </div>

  {Content && <Content />}

  <h2>{t(locale, 'support.legalDocs')}</h2>
  <ul>
    <li>
      <a href={localizePath(`${rawApp.slug}/privacy/`, locale)}>{t(locale, 'nav.privacy')}</a>
    </li>
    <li>
      <a href={localizePath(`${rawApp.slug}/terms/`, locale)}>{t(locale, 'nav.terms')}</a>
    </li>
  </ul>
</LegalLayout>
