---
import '@/styles/reset.css';
import type { AppConfig } from '@/apps/types';
import { themeToCss } from '@/lib/theme';
import { site } from '@/config/site';

interface Props {
  title: string;
  app?: AppConfig;
  description?: string;
  /** OGP 画像の URL（省略時はアプリアイコン／サイト既定） */
  ogImage?: string;
}

const { title, app, description, ogImage } = Astro.props;
const pageTitle = app && title !== app.name ? `${title} — ${app.name}` : title;
const pageDescription = description ?? (app ? `${app.name} — ${title}` : title);
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, site.publicBaseUrl).href;
const ogImageUrl = ogImage ? new URL(ogImage, site.publicBaseUrl).href : undefined;
const themeCss = app ? themeToCss(app.slug, app.theme, app.darkTheme) : undefined;
---

<!doctype html>
<html lang="ja" data-app={app?.slug}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}favicon.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={app?.name ?? site.operatorName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    {themeCss && <style is:inline set:html={themeCss} />}
  </head>
  <body>
    <slot />
  </body>
</html>
