---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/legal.css';
import { site } from '@/config/site';
import type { AppConfig } from '@/apps/types';
import { getSupportEmail } from '@/apps';

interface Props {
  title: string;
  app?: AppConfig;
  currentPath?: 'support' | 'privacy' | 'terms';
  updated?: Date;
}

const { title, app, currentPath, updated } = Astro.props;
const supportEmail = app ? getSupportEmail(app) : site.defaultSupportEmail;
const base = import.meta.env.BASE_URL;

const formatDate = (date: Date) =>
  date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });

const navItems = app
  ? ([
      { key: 'support', label: 'サポート', href: `${base}${app.slug}/support/` },
      { key: 'privacy', label: 'プライバシーポリシー', href: `${base}${app.slug}/privacy/` },
      { key: 'terms', label: '利用規約', href: `${base}${app.slug}/terms/` },
    ] as const)
  : [];
---

<BaseLayout title={title} app={app}>
  <header class="site-header">
    <div class="site-header__inner">
      <p class="site-header__title">
        <a href={app ? `${base}${app.slug}/` : base}>{app ? app.name : 'アプリ一覧'}</a>
      </p>
    </div>
  </header>

  <main class="legal-main">
    <h1 class="page-title">{title}</h1>

    {
      updated && (
        <p class="page-meta">
          最終更新日: {formatDate(updated)}
          {site.operatorName.trim() && <> · 運営者: {site.operatorName}</>}
        </p>
      )
    }

    {
      navItems.length > 0 && (
        <nav class="nav-links" aria-label="法務ページ">
          {navItems.map((item) => (
            <a href={item.href} aria-current={currentPath === item.key ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      )
    }

    <div class="prose">
      <slot />
    </div>

    {
      app && currentPath !== 'support' && (
        <div class="contact-block">
          <p>
            お問い合わせ: <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
          </p>
        </div>
      )
    }
  </main>

  <footer class="site-footer">
    <p>
      &copy; {new Date().getFullYear()} {site.operatorName}
      {app && <> · <a href={base}>アプリ一覧</a></>}
    </p>
  </footer>
</BaseLayout>
