---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/legal.css';
import { site } from '@/config/site';
import type { AppConfig } from '@/apps/types';
import { getSupportEmail } from '@/apps';

interface Props {
  title: string;
  app?: AppConfig;
  currentPath?: 'support' | 'privacy' | 'terms';
  updated?: Date;
}

const { title, app, currentPath, updated } = Astro.props;
const supportEmail = app ? getSupportEmail(app) : site.defaultSupportEmail;
const base = import.meta.env.BASE_URL;

const formatDate = (date: Date) =>
  date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} app={app}>
  <header class="site-header">
    <div class="site-header__inner">
      {
        app ? (
          <>
            <p class="site-header__hub">
              <a href={base}>App Legal</a>
            </p>
            <p class="site-header__title">
              <a href={`${base}${app.slug}/`}>{app.name}</a>
            </p>
          </>
        ) : (
          <p class="site-header__title">
            <a href={base}>App Legal</a>
          </p>
        )
      }
    </div>
  </header>

  <main class="legal-main">
    <h1 class="page-title">{title}</h1>

    {
      updated && (
        <p class="page-meta">
          最終更新日: {formatDate(updated)}
          {site.operatorName.trim() && <> · 運営者: {site.operatorName}</>}
        </p>
      )
    }

    {
      app && (
        <ul class="nav-links">
          <li>
            <a
              href={`${base}${app.slug}/support/`}
              aria-current={currentPath === 'support' ? 'page' : undefined}
            >
              サポート
            </a>
          </li>
          <li>
            <a
              href={`${base}${app.slug}/privacy/`}
              aria-current={currentPath === 'privacy' ? 'page' : undefined}
            >
              プライバシーポリシー
            </a>
          </li>
          <li>
            <a
              href={`${base}${app.slug}/terms/`}
              aria-current={currentPath === 'terms' ? 'page' : undefined}
            >
              利用規約
            </a>
          </li>
        </ul>
      )
    }

    <div class="prose">
      <slot />
    </div>

    {
      app && currentPath !== 'support' && (
        <div class="contact-block">
          <p>
            お問い合わせ: <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
          </p>
        </div>
      )
    }
  </main>

  <footer class="site-footer">
    <p>&copy; {new Date().getFullYear()} {site.operatorName}</p>
  </footer>
</BaseLayout>
