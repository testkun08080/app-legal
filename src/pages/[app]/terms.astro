---
import LegalLayout from '@/layouts/LegalLayout.astro';
import { apps } from '@/config/apps/index';
import { appPaths, getLegalDoc } from '@/lib/legal';
import { render } from 'astro:content';

export function getStaticPaths() {
  return appPaths(apps);
}

const { app } = Astro.props;
const doc = await getLegalDoc(app.slug, 'terms');

if (!doc) {
  throw new Error(`Missing terms document for app: ${app.slug}`);
}

const { Content } = await render(doc);
---

<LegalLayout
  title={doc.data.title}
  app={app}
  currentPath="terms"
  updated={doc.data.updated}
>
  <Content />
</LegalLayout>
