---
import { extraPagePaths } from '@/lib/app-pages';
import type { AppConfig } from '@/apps/types';
import type { Locale } from '@/config/i18n';

interface Props {
  app: AppConfig;
  locale: Locale;
  loader: () => Promise<{ default: (props: { app: AppConfig; locale?: Locale }) => unknown }>;
}

export function getStaticPaths() {
  return extraPagePaths('en');
}

const { app, loader, locale } = Astro.props;
const Page = (await loader()).default;
---

<Page app={app} locale={locale} />
