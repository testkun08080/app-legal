---
import LegalLayout from '@/layouts/LegalLayout.astro';
import { apps } from '@/apps';

const base = import.meta.env.BASE_URL;
---

<LegalLayout title="アプリ一覧">
  <p>各アプリの紹介ページと、プライバシーポリシー・利用規約・サポート情報です。</p>

  <ul class="app-grid">
    {
      apps.map((app) => (
        <li class="app-card" style={`border-top: 3px solid ${app.theme.accent}`}>
          <h2>
            <a href={`${base}${app.slug}/`}>{app.name}</a>
          </h2>
          <p>{app.tagline}</p>
          <div class="app-card__links">
            <a href={`${base}${app.slug}/`}>アプリページ</a>
            <a href={`${base}${app.slug}/support/`}>サポート</a>
            <a href={`${base}${app.slug}/privacy/`}>プライバシーポリシー</a>
            <a href={`${base}${app.slug}/terms/`}>利用規約</a>
          </div>
        </li>
      ))
    }
  </ul>
</LegalLayout>
